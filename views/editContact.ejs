<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <h1>Form Ubah Data Contact</h1>

            <% if ( typeof errors != 'undefined' ) { %>
                <div class="alert alert-danger" role="alert">
                    <ul>
                        <% errors.forEach(error => { %>
                            <li> <%= error.msg %></li>
                            <% }) %>
                    </ul>
                </div>
                <% } %>

                    <form method="post" action="/contact/update">
                        <input type="hidden" name="oldName" value="<%= (contact.oldName) ? contact.oldName : contact.nama %>">
                        <div class="mb-3">
                            <label for="nama" class="form-label">Nama</label>
                            <input type="text" class="form-control" id="nama" name="nama" required value="<%= contact.nama %>">
                        </div>
                        <div class="mb-3">
                            <label for="nohp" class="form-label">No. Handphone</label>
                            <input type="number" class="form-control" id="nohp" name="nohp" required value="<%= contact.nohp%>">
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label">Email address</label>
                            <input type="email" class="form-control" id="email" name="email" value="<%= contact.email %>">
                        </div>
                        <button type="submit" class="btn btn-primary">Ubah Data Contact</button>
                        <a href="/contact" class="card-link d-block mt-3">&laquo; Kembali ke daftar Contact</a>
                    </form>
        </div>
    </div>
</div>